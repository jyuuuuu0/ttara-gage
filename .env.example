# ── Supabase (대시보드 > Project Settings > API Keys) ──
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# 서버 전용 비밀 키. 절대 NEXT_PUBLIC_ 을 붙이지 말 것 (가게 매칭 결과 저장에만 사용)
SUPABASE_SECRET_KEY=sb_secret_...

# ── 가게 정보 API ──
# mock: 목업 / kskill: K-Skill 공개 프록시(권장, 키·고정IP 불필요) / live: 잇플 직접 호출(기관코드+고정IP)
EATPL_MODE=kskill
EATPL_BASE_URL=https://dev-api.paybooc.ai/api/mer
EATPL_INST_NM=
# Vercel 처럼 IP가 바뀌는 곳에 배포할 때: 고정 IP 서버의 relay/server.mjs 주소와 비밀값
EATPL_RELAY_URL=
EATPL_RELAY_SECRET=
